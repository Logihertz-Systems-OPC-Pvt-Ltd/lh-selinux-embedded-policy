# ==============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
LIB_DIR="${PROJECT_ROOT}/lib"

export PYTHONPATH="${LIB_DIR}:${PYTHONPATH:-}"

exec python3 "${LIB_DIR}/cli.py" "$@"
